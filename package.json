{
  "name": "@audio/saturate",
  "version": "1.2.0",
  "type": "module",
  "sideEffects": false,
  "description": "Saturation — umbrella for @audio/saturate-* atoms (tape, tube, transistor, waveshaper, multiband)",
  "workspaces": [
    "packages/*"
  ],
  "keywords": [
    "audio",
    "dsp",
    "saturation",
    "tape",
    "tube",
    "harmonics"
  ],
  "license": "MIT",
  "author": "Dmitry Iv. <dfcreative@gmail.com>",
  "engines": {
    "node": ">=18"
  },
  "main": "index.js",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json",
    "./*": {
      "types": "./members/*.d.ts",
      "default": "./members/*.js"
    }
  },
  "files": [
    "index.js",
    "*.d.ts",
    "members/"
  ],
  "scripts": {
    "test": "node test.js",
    "test:all": "npm test --workspaces --if-present && npm test",
    "publish:all": "node ../compile/tools/tested.js && npm publish --workspaces && npm publish",
    "members": "node scripts/members.js",
    "prepublishOnly": "node ../compile/tools/tested.js && node scripts/members.js --check"
  },
  "dependencies": {
    "@audio/saturate-waveshaper": "^1.2.0",
    "@audio/saturate-tube": "^1.1.0",
    "@audio/saturate-transistor": "^1.2.0",
    "@audio/saturate-tape": "^1.2.0",
    "@audio/saturate-multiband": "^1.2.0"
  },
  "devDependencies": {
    "tst": "^9.4.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/audiojs/saturate.git"
  },
  "funding": "https://github.com/sponsors/audiojs",
  "types": "./index.d.ts"
}
